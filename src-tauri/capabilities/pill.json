{
  "identifier": "pill",
  "description": "Floating dictation pill: listen to events, drag, and click-through toggling",
  "windows": ["pill"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-position",
    "core:window:allow-set-ignore-cursor-events"
  ]
}
